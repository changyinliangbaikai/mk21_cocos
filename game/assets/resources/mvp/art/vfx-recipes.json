{
  "schemaVersion": 1,
  "packId": "mvp-v1",
  "kind": "engine-effect-recipes",
  "status": "in_review",
  "integrationStatus": "adapter_required",
  "coordinateSystem": {
    "designResolution": [
      720,
      1280
    ],
    "authoringPointOrigin": "top-left",
    "worldConversion": "consumer maps authoritative world coordinates to the combat layer once"
  },
  "clockPolicy": {
    "battle": "tick/tick_hz; paused means frozen; x2 advances tick twice as fast",
    "ui": "real presentation time; no damage/cooldown/accounting side effects",
    "audio": "audio director normal playback rate; no pitch/rate multiplication at x2"
  },
  "eventPolicy": {
    "dedupKey": "runId + monotonic effect event id; pulse events add pulseIndex",
    "source": "committed game state/events only",
    "replayAfterLoad": false,
    "animationDoesNotApplyDamage": true,
    "gameplayAreaNeverReadFromTexture": true
  },
  "particleBudget": {
    "maxActiveTexturedQuads": 96,
    "maxPerRecipe": 16,
    "maxStatusMarkersPerTarget": 2,
    "offscreenCull": true,
    "poolReuse": true,
    "lowLoadScale": 0.5,
    "preserveAtLowLoad": [
      "aim outline",
      "danger direction",
      "boss tell",
      "base shield",
      "current status icon"
    ]
  },
  "revivalBranchPolicy": "The committed rescue transaction selects composition. Common REVIVE never includes CLEAR. Detailed ad/cancel/technical-fallback rules remain in docs/design/系统规则与边界.md section 6.",
